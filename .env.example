# Trakt API Credentials
TRAKT_CLIENT_ID=your_client_id_here
TRAKT_USERNAME=your_trakt_username

# TMDB API Key
TMDB_API_KEY=your_tmdb_api_key

# OMDb API Key (optional - for IMDb & Rotten Tomatoes ratings)
OMDB_API_KEY=your_omdb_api_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token

# Telegram Channels (Separate or same)
TELEGRAM_CHAT_ID_MOVIES=your_movie_chat_id
TELEGRAM_CHAT_ID_EPISODES=your_episode_chat_id
# Fallback if above are not set:
TELEGRAM_CHAT_ID=your_default_chat_id

# Telegram User Info (for notifications)
TELEGRAM_USERNAME=your_telegram_username
TELEGRAM_USER_DISPLAY=Your Display Name
